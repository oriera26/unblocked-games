rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Què es guarda on
    // =========================================================================
    //
    //   users/{uid}                     metadades del compte (correu, nom,
    //                                   quan s'ha vist per darrer cop)
    //   users/{uid}/state/{clau}        progrés de l'aplicació: una entrada
    //                                   per clau `ula*` de localStorage, així
    //                                   el que és petit va sol i el que és gran
    //                                   no arrossega la resta
    //   users/{uid}/saves/{joc}         els saves d'un joc concret, amb el
    //                                   joc com a identificador
    //
    //   profiles/{uid}                  perfil social (nom, nom d'usuari,
    //                                   bio, foto, icona, punts, ratxa)
    //   friendships/{pairId}            amistats (status: pending | accepted)
    //   leagues/{id}                    lliga: nom, objectiu (>= 25.000 XP),
    //                                   membres i el mapa
    //                                   { uid: { name, photo, icon } }
    //   leagues/{id}/seasons/{n}        puntuacions de la temporada en curs;
    //                                   cadascú només pot tocar la seva entrada
    //   leagueWinners/{id}_{n}          rètol del guanyador d'una temporada
    //                                   (es crea un cop i ja no es toca)
    //   feed/{docId}                    activitat pública (darreres 20)
    //   gifts/{docId}                   regals globals (reclamables)
    //   chat/{channelId}/messages/{msgId} xat per canals (global obert;
    //                                   de lliga, només per als membres)
    //   chats/{uid1__uid2}              xat 1 a 1: els dos uids, les fitxes
    //                                   i l'últim missatge
    //   chats/{uid1__uid2}/messages/{msgId}
    //                                   missatges del xat 1 a 1
    //   config/{docId}                  configuració de l'aplicació (la
    //                                   clau d'imgbb; només es llegeix)
    //
    // Tot és per sota de users/{uid} o col·leccions globals amb regles pròpies.
    //
    // =========================================================================
    // Per què és segur així i no amb més coses
    // =========================================================================
    //
    //  · El {uid} del camí ha de coincidir amb el del token d'autenticació.
    //    Un usuari no pot escriure a /users/altraGent/, perquè el seu token
    //    porta un uid diferent del que demana el camí.
    //
    //  · No hi ha cap altra regla permissiva. Si algú inventa una
    //    col·lecció nova (/secrets, /config, /tmp, el que sigui), cau al
    //    `match /{document=**}` de baix, que és un `if false` rotund.
    //    Sense aquesta línia, les col·leccions noves no tindrien regla i
    //    el comportament per defecte no és pas el que un s'imagina.
    //
    //  · L'usuari ha d'estar autenticat. Sense sessió, no es llegeix
    //    res, ni tan sols lo seu.
    //
    // Què NO es pot fer amb regles, i ho recordo perquè és fàcil
    // d'oblidar:
    //
    //  · No es pot limitar la mida del document. Firestore ja posa 1 MiB
    //    de sostre; les regles no tenen manera de mesurar bytes. Per això
    //    els saves es parteixen per joc (un document per joc, no un de
    //    sol per a tot) i hi ha un avís a l'hora d'engreixar-los.
    //
    //  · No es pot limitar la freqüència d'escriptura. Els 20.000
    //    escrits/dia del pla gratuït es gestionen agrupant i retardant
    //    les escriptures des del client, no des d'aquí.
    //
    // =========================================================================
    // Prova local de les regles
    // =========================================================================
    //
    // Les regles no es poden provar mirant-les: cal un motor que les
    // avaluï. Aquest és el que fa l'emulador de Firestore (necessita Java):
    //
    //   firebase emulators:start --only firestore --project unblocked-games-by-ula
    //
    // i llavors, amb dos usuaris de mentida A i B, es comprova que
    // A pot llegir /users/A i no pot llegir /users/B. Les comprovacions
    // estructurals que sí que es fan sense navegador són a
    // `tools/check-firebase.mjs`, que corre amb `node tools/check-all.mjs`.
    // =========================================================================

    // --- Progrés d'usuari (sync, saves, favorits, volums) ---
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // --- Social: Perfil propi ---
    // L'actualització només pot tocar aquestes claus: així ningú no es pot
    // inventar camps ni escriure on no toca. `at` és quan s'ha tocat.
    // `uid` és el rastre de la primera versió del Social: hi ha perfils
    // antics que el porten i, com que la comprovació és sobre el document
    // sencer, sense això no es podrien editar mai.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            'name', 'nameLower', 'username', 'bio', 'photo', 'icon',
            'points', 'lvl', 'streak', 'status', 'game', 'giftsBalance', 'at',
            'uid'
          ]);
    }

    // --- Social: Amistats (pairId = uid1__uid2 ordenats) ---
    match /friendships/{pairId} {
      // La parella viu dins del propi identificador, així que la lectura
      // d'un document concret es comprova pel camí. No es pot comprovar
      // per `resource`: el client llegeix l'amistat ABANS d'enviar la
      // primera sol·licitud i, quan el document encara no existeix,
      // `resource` és nul — una regla que hi mirés els camps petaria i
      // denegaria la lectura (justament això va fer caure «afegir amic»).
      allow get: if request.auth != null && request.auth.uid in pairId.split('__');
      // Les consultes (list) sí que poden mirar les dades: Firestore les
      // lliga amb el `where('uids', 'array-contains', uid)` del client.
      allow list: if request.auth != null && request.auth.uid in resource.data.uids;
      allow create: if request.auth != null
          && request.auth.uid in request.resource.data.uids
          && request.resource.data.uids.size() == 2
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedBy == request.auth.uid;
      // Després de crear-la només hi ha dos canvis legítims: acceptar
      // (només qui rep la sol·licitud) i fixar (qualsevol de les dues
      // parts). La parella `uids` no es pot reescriure mai: si no, algú
      // podria fer-se passar per amic de qui volgués.
      allow update: if request.auth != null
          && request.auth.uid in resource.data.uids
          && request.resource.data.uids == resource.data.uids
          && (
            (resource.data.status == 'pending'
              && request.resource.data.status == 'accepted'
              && request.resource.data.acceptedAt != null
              && request.auth.uid != resource.data.requestedBy)
            ||
            (resource.data.status == 'accepted'
              && request.resource.data.status == 'accepted'
              && request.resource.data.acceptedAt == resource.data.acceptedAt)
          );
      allow delete: if request.auth != null
          && request.auth.uid in resource.data.uids;
    }

    // --- Social: Lligues (temporada de 21 dies) ---
    // Una lliga és un grup tancat. Només la veu qui hi és membre, i només
    // els membres la poden tocar: el client restringeix qui pot convidar
    // (l'amo), però la regla deixa passar els canvis que un membre faria
    // sobre la seva pròpia pertinença (marxar, donar el relleu).
    match /leagues/{leagueId} {
      allow get, list: if request.auth != null
          && request.auth.uid in resource.data.memberUids;

      allow create: if request.auth != null
          && request.resource.data.ownerUid == request.auth.uid
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.size() <= 30
          && request.resource.data.goal >= 25000
          && request.resource.data.keys().hasOnly([
            'name', 'icon', 'ownerUid', 'goal', 'createdAt',
            'memberUids', 'members', 'at'
          ]);

      // En una actualització: la lliga no canvia de dates ni de terra, qui
      // mana hi ha de ser, i com a molt s'hi afegeixen deu membres d'un cop.
      allow update: if request.auth != null
          && request.auth.uid in resource.data.memberUids
          && request.resource.data.keys().hasOnly([
            'name', 'icon', 'ownerUid', 'goal', 'createdAt',
            'memberUids', 'members', 'at'
          ])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.ownerUid in request.resource.data.memberUids
          && request.resource.data.goal >= 25000
          && request.resource.data.memberUids.size() <= 30
          && request.resource.data.memberUids.toSet()
                .difference(resource.data.memberUids.toSet()).size() <= 10;

      allow delete: if request.auth != null
          && request.auth.uid in resource.data.memberUids;
    }

    // --- Social: Puntuacions de la temporada ---
    // El document és compartit i cada membre només pot tocar la seva
    // entrada del mapa `scores`. El `diff` de mapes mira les claus de
    // primer nivell: la resta d'entrades no es poden ni tocar ni esborrar.
    match /leagues/{leagueId}/seasons/{season} {
      function isMember() {
        return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId))
                  .data.memberUids;
      }

      allow get, list: if isMember();

      allow create: if isMember()
          && request.resource.data.keys().hasOnly(['scores', 'at'])
          && request.resource.data.scores.keys().hasOnly([request.auth.uid]);

      allow update: if isMember()
          && request.resource.data.keys().hasOnly(['scores', 'at'])
          && request.resource.data.scores.diff(resource.data.scores)
                .affectedKeys().hasOnly([request.auth.uid]);
    }

    // --- Social: Rètol del guanyador ---
    // El doc porta el rètol d'una temporada acabada. El crea qualsevol
    // membre de la lliga (el primer que hi passa quan la temporada ha
    // acabat) i ja no es torna a tocar.
    match /leagueWinners/{winnerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.keys().hasOnly([
            'leagueId', 'season', 'winnerUids', 'winners', 'at'
          ])
          && request.resource.data.winners.size() <= 3
          && request.auth.uid in get(/databases/$(database)/documents/leagues/$(request.resource.data.leagueId))
                .data.memberUids;
    }

    // --- Social: Feed (activitat pública) ---
    match /feed/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['actorUid', 'actorName', 'actorIcon', 'game', 'score', 'at', 'reactions']);
    }

    // --- Social: Regals globals ---
    match /gifts/{docId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null
          && !resource.data.claimedBy.hasAny([request.auth.uid])
          && request.resource.data.claimedBy.hasOnly([request.auth.uid]);
    }

    // --- Social: Xat per canals ---
    // El canal global («global») és obert a tothom qui ha iniciat sessió.
    // Els canals de lliga («league__<id>») són només per als membres: el
    // nom del canal porta l'id de la lliga i la regla hi consulta la
    // pertinença. (Els ids de Firestore són alfanumèrics: cap lliga no
    // pot dur «__» i el prefix no es pot confondre amb res més.)
    match /chat/{channelId}/messages/{messageId} {
      function isLeagueChannel() {
        return channelId.split('__')[0] == 'league'
            && channelId.split('__').size() == 2;
      }
      function isForMember() {
        return !isLeagueChannel()
            || request.auth.uid in get(/databases/$(database)/documents/leagues/$(channelId.split('__')[1]))
                  .data.memberUids;
      }
      allow read: if request.auth != null && isForMember();
      allow create: if request.auth != null && isForMember()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'fromIcon', 'text', 'at', 'reactions']);
      allow update: if request.auth != null && isForMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
    }

    // --- Social: Xat 1 a 1 (parella = uid1__uid2 ordenats) ---
    // Com a les amistats, la parella viu dins del propi identificador.
    // El document porta els dos uids i les fitxes; els missatges només
    // són per a les dues persones.
    match /chats/{pairId} {
      allow get: if request.auth != null && request.auth.uid in pairId.split('__');
      allow list: if request.auth != null && request.auth.uid in resource.data.uids;
      allow create: if request.auth != null
          && request.auth.uid in request.resource.data.uids
          && request.resource.data.uids.size() == 2
          && request.resource.data.keys().hasOnly(['uids', 'members', 'at', 'last']);
      allow update: if request.auth != null
          && request.auth.uid in resource.data.uids
          && request.resource.data.uids == resource.data.uids
          && request.resource.data.keys().hasOnly(['uids', 'members', 'at', 'last']);
    }

    match /chats/{pairId}/messages/{messageId} {
      allow read: if request.auth != null && request.auth.uid in pairId.split('__');
      allow create: if request.auth != null
          && request.auth.uid in pairId.split('__')
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'fromIcon', 'text', 'at', 'reactions']);
      allow update: if request.auth != null
          && request.auth.uid in pairId.split('__')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
    }

    // --- Configuració de l'aplicació (clau d'imgbb, etc.) ---
    // Només es llegeix; l'escriptura és cosa del propietari, des de la
    // consola de Firebase. El contingut no és cap secret davant d'algú que
    // faci servir l'aplicació —el navegador l'ha de poder llegir— però així
    // queda fora del repositori i de l'abast dels bots que l'escombrén.
    match /config/{docId} {
      allow read: if request.auth != null;
    }

    // Tot lo altre: prohibit. Això ha de ser l'última línia del fitxer.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}